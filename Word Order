import collections

# Read the number of words
n = int(input())

# Use an OrderedDict to ensure compatibility across all Python versions
# or a standard dict if using Python 3.7+
word_counts = collections.OrderedDict()

for _ in range(n):
    word = input().strip()
    if word in word_counts:
        word_counts[word] += 1
    else:
        word_counts[word] = 1

# Output the number of distinct words
print(len(word_counts))

# Output the occurrences in order of appearance
print(*(word_counts.values()))
