def count_substring(string, sub_string):
    count = 0
    # Iterate through the string to check every possible starting position
    for i in range(len(string) - len(sub_string) + 1):
        # Check if the slice from current index matches the sub_string
        if string[i : i + len(sub_string)] == sub_string:
            count += 1
    return count
