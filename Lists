if __name__ == '__main__':
    n = int(input())
    my_list = []
    
    for _ in range(n):
        args = input().split()
        cmd = args[0]
        
        if cmd == 'insert':
            my_list.insert(int(args[1]), int(args[2]))
        elif cmd == 'print':
            print(my_list)
        elif cmd == 'remove':
            my_list.remove(int(args[1]))
        elif cmd == 'append':
            my_list.append(int(args[1]))
        elif cmd == 'sort':
            my_list.sort()
        elif cmd == 'pop':
            my_list.pop()
        elif cmd == 'reverse':
            my_list.reverse()
