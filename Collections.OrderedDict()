from collections import OrderedDict
n = int(input())
item_dictionary = OrderedDict()

for _ in range(n):
    data = input().split()
    item_name = " ".join(data[:-1])
    price = int(data[-1])
    if item_name in item_dictionary:
        item_dictionary[item_name] += price
    else:
        item_dictionary[item_name] = price
for item, net_price in item_dictionary.items():
    print(f"{item} {net_price}")
